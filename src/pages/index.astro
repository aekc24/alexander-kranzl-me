---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { t } from '../i18n/ui';

const heroSubtitle = siteConfig.heroSubtitle ?? siteConfig.tagline;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .slice(0, 2);

// Aggregate tags with counts
const tagsMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    tagsMap.set(tag, (tagsMap.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagsMap.entries()]
  .sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <section class="hero">
    <h1 class="hero-title">
      {siteConfig.heroTitle ?? 'Crafted for deep thinking & technical writing.'}
    </h1>
    {heroSubtitle && (
      <p class="hero-subtitle">
        {heroSubtitle}
      </p>
    )}
    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary">{t('home.readArticles')}</a>
      {allProjects.length > 0 && <a href="/projects" class="btn btn-secondary">{t('home.exploreProjects')}</a>}
      <a href="/about" class="btn btn-tertiary">{t('home.about')}</a>
    </div>
  </section>

  <!-- Latest Notes -->
  <section class="recent-posts">
    <div class="section-header">
      <h2 class="section-title">{t('home.latest')}</h2>
      <a href="/blog" class="all-link">{t('home.viewAll', { count: allPosts.length })}</a>
    </div>

    <div class="posts-list">
      {recentPosts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="featured-projects">
      <div class="section-header">
        <h2 class="section-title">{t('home.featuredProjects')}</h2>
        <a href="/projects" class="all-link">{t('home.allProjects', { count: allProjects.length })}</a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((proj) => (
          <ProjectCard
            title={proj.data.title}
            description={proj.data.description}
            date={proj.data.date}
            slug={proj.id}
            tags={proj.data.tags}
            stars={proj.data.stars}
            repoUrl={proj.data.repoUrl}
            demoUrl={proj.data.demoUrl}
            category={proj.data.category}
            emoji={proj.data.emoji}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Explore by Topics / Tags Cloud -->
  {siteConfig.features?.tags !== false && topTags.length > 0 && (
    <section class="home-tags-section">
      <div class="section-header">
        <h2 class="section-title">{t('home.topics')}</h2>
        <a href="/tags" class="all-link">{t('home.allTags', { count: topTags.length })}</a>
      </div>

      <div class="tags-cloud">
        {topTags.map(([tag, count]) => (
          <a href={`/tags/${tag}`} class="tag-pill">
            <span class="tag-name">#{tag}</span>
            <span class="tag-count">{count}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .hero-title {
    font-size: 2.4rem;
    line-height: 1.25;
    margin-top: 0;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 640px;
  }

  /* Without a subtitle, keep the space the subtitle would leave above the buttons */
  .hero-title + .hero-actions {
    margin-top: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .btn-tertiary {
    background: transparent;
    color: var(--text-muted);
  }

  .btn-tertiary:hover {
    color: var(--text);
  }

  .recent-posts,
  .featured-projects,
  .home-tags-section {
    margin-top: 3rem;
    padding-top: 1.5rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-title {
    margin: 0;
    font-size: 1.45rem;
    letter-spacing: -0.015em;
  }

  .all-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .all-link:hover {
    color: var(--accent);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 700px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Tags Cloud */
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background-color: var(--bg-surface);
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .tag-pill:hover {
    background-color: var(--bg-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }

  .tag-name {
    font-weight: 500;
  }

  .tag-count {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
    background-color: var(--bg-subtle);
    color: var(--text-muted);
  }
</style>
